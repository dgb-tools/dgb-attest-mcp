{
  "name": "dgb-attest-mcp",
  "version": "0.1.0",
  "description": "Timestamped SHA-256 commitments on DigiByte via OP_RETURN: record a content hash in a transaction, check it later against the chain. Bounds when bytes existed; does not establish who made them or whether they are true.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "digibyte",
    "attestation",
    "provenance",
    "timestamped-commitment",
    "op_return",
    "mcp",
    "ai-agents",
    "timestamping"
  ],
  "author": "Michael Emery",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dgb-attest-mcp": "src/server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "mcpName": "io.github.dgb-tools/dgb-attest-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dgb-tools/dgb-attest-mcp.git"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  }
}
